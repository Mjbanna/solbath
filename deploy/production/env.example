# Templates for the files that live OUTSIDE the repo in /opt/solbath-prod
# (mode 600). Fresh values for production — never copy staging's.

# ---- .env  (compose interpolation, not passed to containers) ---------------
SOLBATH_PROD_WEB_ROUTING=false   # flip to true at cutover, then recreate `web`

# ---- db.env ----------------------------------------------------------------
POSTGRES_DB=solbath_prod
POSTGRES_USER=solbath_prod
POSTGRES_PASSWORD=               # openssl rand -hex 24

# ---- cms.env ---------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=https://api.solbath.com
IS_PROXIED=true
CORS_ORIGIN=https://solbath.com  # add https://www.solbath.com only if the www redirect is removed
APP_KEYS=                        # 4 x openssl rand -base64 24, comma separated
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
DATABASE_CLIENT=postgres
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=solbath_prod
DATABASE_USERNAME=solbath_prod
DATABASE_PASSWORD=               # same as POSTGRES_PASSWORD
DATABASE_SSL=false
UPLOAD_PROVIDER=local
FRONTEND_URL=http://web:3000     # internal compose network
REVALIDATE_SECRET=               # openssl rand -hex 32, identical in web.env

# ---- web.env ---------------------------------------------------------------
NODE_ENV=production
STRAPI_URL=https://api.solbath.com
REVALIDATE_SECRET=

# ---- web image build args (baked in; see deploy/staging/web.Dockerfile) -----
#   STRAPI_URL=https://api.solbath.com  SITE_URL=https://solbath.com  SITE_INDEXABLE=true
